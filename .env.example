# Plantilla de secretos locales. Copiar como .env (no se versiona) y poner valores propios.
# docker compose lo lee solo; keycloak/configurar_realm.py y pruebas-seguridad/comun.ps1 también.
# Política de Keycloak para usuarios: 10 caracteres o más, distinta del usuario y del correo.

# Oracle (contenedor SGE-JD). Solo se aplican al crear el contenedor por primera vez.
ORACLE_PASSWORD=
APP_USER_PASSWORD=

# Postgres de Keycloak
KC_DB_PASSWORD=

# Consola de Keycloak (usuario admin del realm master)
KC_ADMIN_PASSWORD=

# Usuarios del sistema (realm bomerp)
SGEJD_CLAVE_LISANDRO=
SGEJD_CLAVE_LUCY=

# Cuenta de servicio del backend en Keycloak (cliente sgejd-backend): permisos e historial de sesiones.
# Cualquier texto largo y aleatorio; configurar_realm.py lo pone en Keycloak y el backend lo usa.
KC_BACKEND_SECRET=

# Facturación directa a SUNAT, ambiente BETA (pruebas, sin efecto tributario): clave del certificado
# de prueba certificados/beta-prueba.p12 (generarlo con keytool, ver docs/README.md).
SUNAT_CERT_CLAVE=

# Usuarios de Oracle de la migración BD2 (migracion_bd2/migrar.ps1). Si se dejan vacías o no están,
# el script las genera al azar y las agrega a este archivo. JD_APP: el usuario del backend en producción;
# JD_REPORTES: solo lectura, para Excel o un tablero.
JD_APP_PASSWORD=
JD_REPORTES_PASSWORD=
