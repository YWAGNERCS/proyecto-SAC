    <bpmn:sequenceFlow id="Flujo_16" name="No" sourceRef="g4" targetRef="f1" />
    <bpmn:sequenceFlow id="Flujo_17" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="Flujo_18" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="Flujo_19" sourceRef="t12" targetRef="f1" />
  </bpmn:process>
