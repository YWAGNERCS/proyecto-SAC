<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_asis_venta_servicio" targetNamespace="https://ywagnercs.github.io/proyecto-SAC/bpmn" exporter="SGE-JD generar_bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="Colab_asis_venta_servicio">
    <bpmn:participant id="Pool_asis_venta_servicio" name="AS-IS · Venta, instalación y cobro (BORRADOR: supuestos [S1]–[S6] por validar con Lisandro)" processRef="Proceso_asis_venta_servicio" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_asis_venta_servicio" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_cli" name="Cliente">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_ofi" name="Oficina (Lucy)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_due" name="Dueño (Lisandro)">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_tec" name="Técnico">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Necesita un equipo o servicio">
      <bpmn:outgoing>Flujo_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Pide una cotización">
      <bpmn:incoming>Flujo_0</bpmn:incoming>
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t2" name="Arma la proforma en Word o Excel [S1]">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Revisa precios y descuento [S2]">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t4" name="Envía la proforma por correo o WhatsApp">
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t5" name="Revisa la proforma">
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g1" name="¿Acepta?">
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="f0" name="Sin venta">
      <bpmn:incoming>Flujo_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="t6" name="Consulta el stock en el almacén [S3]">
      <bpmn:incoming>Flujo_7</bpmn:incoming>
      <bpmn:outgoing>Flujo_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t7" name="Emite la factura en el portal de SUNAT [S4]">
      <bpmn:incoming>Flujo_8</bpmn:incoming>
      <bpmn:outgoing>Flujo_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g2" name="¿Requiere instalación?">
      <bpmn:incoming>Flujo_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t8" name="Asigna técnico y fecha de memoria o en una agenda [S5]">
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t9" name="Instala el equipo">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
      <bpmn:outgoing>Flujo_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g3" name="">
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:incoming>Flujo_13</bpmn:incoming>
      <bpmn:outgoing>Flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g4" name="¿Es a crédito?">
      <bpmn:incoming>Flujo_14</bpmn:incoming>
      <bpmn:outgoing>Flujo_15</bpmn:outgoing>
      <bpmn:outgoing>Flujo_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t10" name="Anota la deuda en un cuaderno o Excel [S6]">
      <bpmn:incoming>Flujo_15</bpmn:incoming>
      <bpmn:outgoing>Flujo_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t11" name="Paga">
      <bpmn:incoming>Flujo_17</bpmn:incoming>
      <bpmn:outgoing>Flujo_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t12" name="Tacha la deuda como pagada [S6]">
      <bpmn:incoming>Flujo_18</bpmn:incoming>
      <bpmn:outgoing>Flujo_19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="f1" name="Venta cerrada">
      <bpmn:incoming>Flujo_16</bpmn:incoming>
      <bpmn:incoming>Flujo_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_0" sourceRef="i" targetRef="t1" />
