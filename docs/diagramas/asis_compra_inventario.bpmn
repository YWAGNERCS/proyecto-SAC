<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_asis_compra_inventario" targetNamespace="https://ywagnercs.github.io/proyecto-SAC/bpmn" exporter="SGE-JD generar_bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="Colab_asis_compra_inventario">
    <bpmn:participant id="Pool_asis_compra_inventario" name="AS-IS · Compra, pago al proveedor e inventario (BORRADOR: supuestos [S7]–[S9] por validar)" processRef="Proceso_asis_compra_inventario" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_asis_compra_inventario" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_ofi" name="Oficina (Lucy)">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_due" name="Dueño (Lisandro)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_pro" name="Proveedor">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Falta material al ir a usarlo [S7]">
      <bpmn:outgoing>Flujo_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Pide el material al proveedor">
      <bpmn:incoming>Flujo_0</bpmn:incoming>
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t2" name="Entrega la mercadería y la factura">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Archiva la factura y anota lo que llegó [S8]">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g1" name="¿Es a crédito?">
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t4" name="Recuerda la fecha de pago [S9]">
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t5" name="Paga al proveedor">
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g2" name="">
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:incoming>Flujo_7</bpmn:incoming>
      <bpmn:outgoing>Flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="f1" name="Material en almacén">
      <bpmn:incoming>Flujo_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_0" sourceRef="i" targetRef="t1" />
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flujo_4" name="Sí" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flujo_5" name="No" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="t5" targetRef="g2" />
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="g2" targetRef="f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_asis_compra_inventario">
    <bpmndi:BPMNPlane id="Plano_asis_compra_inventario" bpmnElement="Colab_asis_compra_inventario">
