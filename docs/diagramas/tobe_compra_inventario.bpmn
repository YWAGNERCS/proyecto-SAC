<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_tobe_compra_inventario" targetNamespace="https://ywagnercs.github.io/proyecto-SAC/bpmn" exporter="SGE-JD generar_bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="Colab_tobe_compra_inventario">
    <bpmn:participant id="Pool_tobe_compra_inventario" name="TO-BE · Compra, cuentas por pagar e inventario con SGE-JD" processRef="Proceso_tobe_compra_inventario" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_tobe_compra_inventario" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_sis" name="SGE-JD">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_asi" name="Asistente (Lucy)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_adm" name="Administrador (Lisandro)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_pro" name="Proveedor">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Alerta diaria de stock mínimo">
      <bpmn:outgoing>Flujo_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Revisa los materiales bajo el mínimo">
      <bpmn:incoming>Flujo_0</bpmn:incoming>
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t2" name="Pide el material al proveedor">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Entrega la mercadería y la factura">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t4" name="Registra la compra (N° de factura, contado o crédito)">
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s1" name="Rechaza una factura repetida y sube el stock de los materiales">
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Es a crédito?">
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s2" name="La deja en Cuentas por pagar con su vencimiento">
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t5" name="Paga al proveedor">
      <bpmn:incoming>Flujo_8</bpmn:incoming>
      <bpmn:outgoing>Flujo_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t6" name="Registra el pago con su N° de operación">
      <bpmn:incoming>Flujo_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s3" name="Actualiza el saldo y al cubrirlo marca la compra PAGADA">
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="">
      <bpmn:incoming>Flujo_7</bpmn:incoming>
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t7" name="Cuenta el almacén y registra el conteo físico o la merma">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
      <bpmn:outgoing>Flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s4" name="Ajusta el stock, lo muestra en el kardex y lo guarda en el historial">
      <bpmn:incoming>Flujo_13</bpmn:incoming>
      <bpmn:outgoing>Flujo_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="f1" name="Inventario cuadrado">
      <bpmn:incoming>Flujo_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_0" sourceRef="i" targetRef="t1" />
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="t4" targetRef="s1" />
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="s1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flujo_6" name="Sí" sourceRef="g1" targetRef="s2" />
    <bpmn:sequenceFlow id="Flujo_7" name="No" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="s2" targetRef="t5" />
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="t6" targetRef="s3" />
    <bpmn:sequenceFlow id="Flujo_11" sourceRef="s3" targetRef="g2" />
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="g2" targetRef="t7" />
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="t7" targetRef="s4" />
    <bpmn:sequenceFlow id="Flujo_14" sourceRef="s4" targetRef="f1" />
  </bpmn:process>
