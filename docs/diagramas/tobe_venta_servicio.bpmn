<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_tobe_venta_servicio" targetNamespace="https://ywagnercs.github.io/proyecto-SAC/bpmn" exporter="SGE-JD generar_bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="Colab_tobe_venta_servicio">
    <bpmn:participant id="Pool_tobe_venta_servicio" name="TO-BE · Venta, instalación y cobro con SGE-JD" processRef="Proceso_tobe_venta_servicio" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_tobe_venta_servicio" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_cli" name="Cliente">
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_asi" name="Asistente (Lucy)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_tec" name="Técnico">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_sis" name="SGE-JD">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="i" name="Necesita un equipo o servicio">
      <bpmn:outgoing>Flujo_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Pide una cotización">
      <bpmn:incoming>Flujo_0</bpmn:incoming>
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t2" name="Registra la proforma (cliente por RUC/DNI, productos, descuento)">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s1" name="Calcula precios e IGV, aplica el tope de descuento, genera el PDF y lo envía por correo">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t3" name="Revisa la proforma">
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g1" name="¿Acepta?">
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="f0" name="Proforma rechazada o vencida">
      <bpmn:incoming>Flujo_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t4" name="Convierte la proforma en venta (contado o crédito)">
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s2" name="Valida y descuenta stock, emite el comprobante, calcula detracción o retención y programa mantenimientos">
      <bpmn:incoming>Flujo_7</bpmn:incoming>
      <bpmn:outgoing>Flujo_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="¿Requiere instalación?">
      <bpmn:incoming>Flujo_8</bpmn:incoming>
      <bpmn:outgoing>Flujo_9</bpmn:outgoing>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t5" name="Programa la orden de trabajo (técnico, fecha y hora)">
      <bpmn:incoming>Flujo_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s3" name="Verifica que el técnico no tenga otra visita a esa hora (agenda)">
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t6" name="Instala y cierra la orden (materiales usados, quién recibió)">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
      <bpmn:outgoing>Flujo_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="">
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:incoming>Flujo_13</bpmn:incoming>
      <bpmn:outgoing>Flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g4" name="¿Es a crédito?">
      <bpmn:incoming>Flujo_14</bpmn:incoming>
      <bpmn:outgoing>Flujo_15</bpmn:outgoing>
      <bpmn:outgoing>Flujo_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s4" name="Muestra el saldo, los días de atraso y el recordatorio por WhatsApp">
      <bpmn:incoming>Flujo_15</bpmn:incoming>
      <bpmn:outgoing>Flujo_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="t7" name="Paga (transferencia, depósito, Yape…)">
      <bpmn:incoming>Flujo_17</bpmn:incoming>
      <bpmn:outgoing>Flujo_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t8" name="Registra el cobro con su N° de operación">
      <bpmn:incoming>Flujo_18</bpmn:incoming>
      <bpmn:outgoing>Flujo_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s5" name="Rechaza un voucher repetido, actualiza el saldo y al cubrirlo marca la venta PAGADA">
      <bpmn:incoming>Flujo_19</bpmn:incoming>
      <bpmn:outgoing>Flujo_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="f1" name="Venta cobrada">
      <bpmn:incoming>Flujo_16</bpmn:incoming>
      <bpmn:incoming>Flujo_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_0" sourceRef="i" targetRef="t1" />
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="t2" targetRef="s1" />
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="s1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flujo_5" name="No" sourceRef="g1" targetRef="f0" />
    <bpmn:sequenceFlow id="Flujo_6" name="Sí" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="t4" targetRef="s2" />
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="s2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flujo_9" name="Sí" sourceRef="g2" targetRef="t5" />
    <bpmn:sequenceFlow id="Flujo_10" name="No" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="Flujo_11" sourceRef="t5" targetRef="s3" />
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="s3" targetRef="t6" />
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="t6" targetRef="g3" />
    <bpmn:sequenceFlow id="Flujo_14" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="Flujo_15" name="Sí" sourceRef="g4" targetRef="s4" />
    <bpmn:sequenceFlow id="Flujo_16" name="No" sourceRef="g4" targetRef="f1" />
    <bpmn:sequenceFlow id="Flujo_17" sourceRef="s4" targetRef="t7" />
    <bpmn:sequenceFlow id="Flujo_18" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="Flujo_19" sourceRef="t8" targetRef="s5" />
    <bpmn:sequenceFlow id="Flujo_20" sourceRef="s5" targetRef="f1" />
  </bpmn:process>
