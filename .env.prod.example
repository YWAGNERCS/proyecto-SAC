# Secretos del entorno de PRODUCCIÓN local (compose-prod.yml). Plantilla: copiar como .env.prod
# (no se versiona) o generarlo con valores aleatorios:  python scripts/prod/generar_env_prod.py
# Deben ser DISTINTOS a los de .env (dev). Política de Keycloak: 10 caracteres o más.

# Oracle de prod (sge-jd-oracle-prod). Solo se aplican al crear el contenedor por primera vez.
ORACLE_PASSWORD=
APP_USER_PASSWORD=

# Postgres de Keycloak de prod
KC_DB_PASSWORD=

# Consola de Keycloak de prod (usuario admin del realm master)
KC_ADMIN_PASSWORD=

# Usuarios del sistema (realm bomerp de prod)
SGEJD_CLAVE_LISANDRO=
SGEJD_CLAVE_LUCY=

# Cuenta de servicio del backend en Keycloak (cliente sgejd-backend)
KC_BACKEND_SECRET=

# Opcionales: correo de la empresa y consulta de RUC/DNI con token (vacíos = desactivados)
MAIL_USERNAME=
MAIL_PASSWORD=
CORREO_OFICINA=
DECOLECTA_TOKEN=
