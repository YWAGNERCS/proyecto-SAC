# Secretos del entorno de PRODUCCIÓN local (compose-prod.yml). Plantilla: copiar como .env.prod
# (no se versiona) o generarlo con valores aleatorios:  python scripts/prod/generar_env_prod.py
# Deben ser DISTINTOS a los de .env (dev). Política de Keycloak: 10 caracteres o más.

# Oracle de prod (sge-jd-oracle-prod). Solo se aplican al crear el contenedor por primera vez.
ORACLE_PASSWORD=
APP_USER_PASSWORD=

# Postgres de Keycloak de prod
KC_DB_PASSWORD=

# Consola de Keycloak de prod (usuario admin del realm master)
KC_ADMIN_PASSWORD=

# Usuarios del sistema (realm bomerp de prod)
SGEJD_CLAVE_LISANDRO=
SGEJD_CLAVE_LUCY=

# Cuenta de servicio del backend en Keycloak (cliente sgejd-backend)
KC_BACKEND_SECRET=

# Opcionales: correo de la empresa y consulta de RUC/DNI con token (vacíos = desactivados)
# MAIL_USERNAME/MAIL_PASSWORD: cuenta que envía las facturas y boletas a los clientes (en Gmail, una
# "contraseña de aplicación"). Sin ellas, los correos de comprobantes quedan "No se pudo enviar" y se reintentan.
MAIL_USERNAME=
MAIL_PASSWORD=
CORREO_OFICINA=
DECOLECTA_TOKEN=
# Contacto oficial de JD que se muestra al pie del correo del comprobante (vacíos = no se muestran)
EMPRESA_TELEFONO=
EMPRESA_CORREO=
EMPRESA_WEB=

# --- Facturación electrónica directa a SUNAT (ver docs/FACTURACION_SUNAT.md) ---
# simulado (no envía nada) o sunat. La URL decide el ambiente:
#   beta (pruebas):  https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService  (usuario y clave MODDATOS)
#   producción:      https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
FACTURACION_MODO=
# Con FACTURACION_MODO=sunat, OBLIGATORIO: PRODUCCION o BETA. Tiene que corresponder a SUNAT_URL (la dirección
# oficial de ese ambiente); si no, el backend no arranca. No se deduce de la URL.
SUNAT_AMBIENTE=
SUNAT_URL=
# Usuario SOL SECUNDARIO de JD (sin el RUC) con permiso solo de comprobantes electrónicos, y su clave
SUNAT_USUARIO=
SUNAT_CLAVE=
# Archivo del certificado digital dentro de bomerp-backend/certificados/ (p. ej. jd-refrigeracion.pfx) y su contraseña
SUNAT_CERT_ARCHIVO=
SUNAT_CERT_CLAVE=
# Cuenta de detracciones de JD en el Banco de la Nación (obligatoria para facturas con detracción)
CUENTA_DETRACCIONES=
# Series de SGE-JD (cambiarlas si JD ya usa F001/B001 en otro sistema)
SERIE_FACTURA=
SERIE_BOLETA=
SERIE_NOTA_FACTURA=
SERIE_NOTA_BOLETA=
